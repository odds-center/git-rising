{
  "name": "git-rising",
  "productName": "Git Rising",
  "version": "0.2.8",
  "description": "가볍고 컴팩트한 git 그래프 뷰어 (macOS / Windows)",
  "type": "module",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win",
    "install:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 && rm -rf '/Applications/Git Rising.app' && cp -R 'dist/mac-arm64/Git Rising.app' /Applications/ && xattr -dr com.apple.quarantine '/Applications/Git Rising.app'",
    "mcp": "node src/mcp.js",
    "postinstall": "node -e \"for(const a of ['arm64','x64']){try{require('fs').chmodSync('node_modules/node-pty/prebuilds/darwin-'+a+'/spawn-helper',0o755)}catch{}}\"",
    "check": "tsc -p ."
  },
  "build": {
    "appId": "com.oddscenter.gitrising",
    "productName": "Git Rising",
    "files": [
      "src/**",
      "public/**",
      "package.json",
      "node_modules/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": false,
    "artifactName": "git-rising-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx-preview": "^0.4.1",
    "jszip": "^3.10.2",
    "marked": "^18.2.0",
    "node-pty": "^1.1.0",
    "ws": "^8.23.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
