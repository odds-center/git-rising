{
  "name": "git-rising",
  "productName": "Git Rising",
  "version": "0.1.0",
  "description": "가볍고 컴팩트한 git 그래프 뷰어 (macOS / Windows)",
  "type": "module",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win",
    "install:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 && rm -rf '/Applications/Git Rising.app' && cp -R 'dist/mac-arm64/Git Rising.app' /Applications/"
  },
  "build": {
    "appId": "com.oddscenter.gitrising",
    "productName": "Git Rising",
    "files": [
      "src/**",
      "public/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  }
}
